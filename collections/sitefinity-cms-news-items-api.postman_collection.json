  "info": {
    "_postman_id": "b46d2fc2-b9ae-484c-818b-58c7c48ed973",
    "name": "Sitefinity CMS Content Blog Posts News Items API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Sitefinity CMS Content API provides RESTful access to all content types defined in a Sitefinity instance. It exposes endpoints for creating, reading, updating, deleting, publishing, and unpublishing content items across all dynamic content types (news items, blog posts, events, etc.) and custom types defined through the CMS content model. The API follows OData conventions for filtering, sorting, and pagination. Authentication is handled via forms-based authentication or token-based auth depending on the Sitefinity configuration.\n\nContact Support:\n Name: Progress Sitefinity Support",
      "type": "text/plain"
    }
  }
