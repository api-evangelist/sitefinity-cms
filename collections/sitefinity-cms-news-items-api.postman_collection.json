          "name": "List News Items",
          "request": {
            "name": "List News Items",
            "description": {
              "content": "Retrieves a paginated list of news items from Sitefinity CMS. Supports OData query options for filtering, sorting, and selecting specific fields. Returns news items that are visible to the authenticated user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "newsitems"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$top",
                  "value": "50",
                  "description": "Maximum number of items to return (OData $top)"
                },
                {
                  "disabled": false,
                  "key": "$skip",
                  "value": "0",
                  "description": "Number of items to skip for pagination (OData $skip)"
                },
                {
                  "disabled": false,
                  "key": "$filter",
                  "value": "<string>",
                  "description": "OData filter expression (e.g., Status eq 'Published')"
                },
                {
                  "disabled": false,
                  "key": "$orderby",
                  "value": "<string>",
                  "description": "OData orderby clause (e.g., PublicationDate desc)"
                },
                {
                  "disabled": false,
                  "key": "$select",
                  "value": "<string>",
                  "description": "Comma-separated list of fields to return"
                }
              ],
              "variable": [
                {
                  "description": "The Sitefinity instance hostname",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                }
              ]
